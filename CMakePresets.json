{
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "version": 10,
  "cmakeMinimumRequired": { "major": 4, "minor": 2, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-v145",
        "VCPKG_INSTALL_OPTIONS": "--x-buildtrees-root=${sourceDir}/out/vcpkg-bt"
      },
      "environment": { "VCPKG_DISABLE_METRICS": "1" }
    },
    {
      "name": "vs2026",
      "inherits": "base",
      "displayName": "Visual Studio 2026 (multi-config)",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "toolset": { "value": "v145", "strategy": "set" }
    },
    {
      "name": "ninja-debug",
      "inherits": "base",
      "displayName": "Ninja Debug (run inside VsDevCmd)",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "ninja-release",
      "inherits": "base",
      "displayName": "Ninja Release (run inside VsDevCmd)",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "vs2026-debug", "configurePreset": "vs2026", "configuration": "Debug" },
    { "name": "vs2026-release", "configurePreset": "vs2026", "configuration": "Release" },
    { "name": "ninja-debug", "configurePreset": "ninja-debug" },
    { "name": "ninja-release", "configurePreset": "ninja-release" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "vs2026-debug", "inherits": "test-base", "configurePreset": "vs2026", "configuration": "Debug" },
    { "name": "vs2026-release", "inherits": "test-base", "configurePreset": "vs2026", "configuration": "Release" },
    { "name": "ninja-debug", "inherits": "test-base", "configurePreset": "ninja-debug" },
    { "name": "ninja-release", "inherits": "test-base", "configurePreset": "ninja-release" }
  ]
}
